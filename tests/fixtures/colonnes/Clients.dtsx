    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\DFT Clients"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:ObjectName="DFT Clients">
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\DFT Clients\FF Clients"
              componentClassID="Microsoft.FlatFileSource"
              name="FF Clients">
              <connections>
                <connection
                  refId="Package\DFT Clients\FF Clients.Connections[FlatFileConnection]"
                  connectionManagerID="{E0000000-0000-0000-0000-000000000001}"
