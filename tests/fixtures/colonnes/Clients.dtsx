                      name="pays_libelle">
                      <properties>
                        <property
                          dataType="System.String"
                          name="CopyFromReferenceColumn">libelle</property>
                      </properties>
                    </outputColumn>
                  </outputColumns>
                </output>
              </outputs>
            </component>
            <component
