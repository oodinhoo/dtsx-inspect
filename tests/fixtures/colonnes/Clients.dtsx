                      externalMetadataColumnId="Package\DFT Clients\DST Clients.Inputs[Entree].ExternalColumns[email]"
                      lineageId="Package\DFT Clients\DER Email.Outputs[Sortie].Columns[email_norm]" />
                    <inputColumn
