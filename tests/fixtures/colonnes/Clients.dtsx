                      dataType="wstr"
                      externalMetadataColumnId="Package\DFT Clients\FF Clients.Outputs[Sortie].ExternalColumns[pays_code]"
                      lineageId="Package\DFT Clients\FF Clients.Outputs[Sortie].Columns[pays_code]"
                      name="pays_code" />
                  </outputColumns>
                  <externalMetadataColumns
                    isUsed="True">
                    <externalMetadataColumn
                      refId="Package\DFT Clients\FF Clients.Outputs[Sortie].ExternalColumns[id]"
                      dataType="wstr"
                      name="id" />
                    <externalMetadataColumn
                      refId="Package\DFT Clients\FF Clients.Outputs[Sortie].ExternalColumns[email]"
                      dataType="wstr"
                      name="email" />
                    <externalMetadataColumn
                      refId="Package\DFT Clients\FF Clients.Outputs[Sortie].ExternalColumns[pays_code]"
                      dataType="wstr"
                      name="pays_code" />
                  </externalMetadataColumns>
                </output>
              </outputs>
            </component>
            <component
              refId="Package\DFT Clients\DER Email"
              componentClassID="Microsoft.DerivedColumn"
              name="DER Email">
              <inputs>
                <input
                  refId="Package\DFT Clients\DER Email.Inputs[Entree]"
                  name="Entree" />
              </inputs>
              <outputs>
                <output
                  refId="Package\DFT Clients\DER Email.Outputs[Sortie]"
                  name="Sortie">
                  <outputColumns>
                    <outputColumn
                      refId="Package\DFT Clients\DER Email.Outputs[Sortie].Columns[email_norm]"
                      dataType="wstr"
                      lineageId="Package\DFT Clients\DER Email.Outputs[Sortie].Columns[email_norm]"
                      name="email_norm">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          name="Expression">LOWER(TRIM(#{Package\DFT Clients\FF Clients.Outputs[Sortie].Columns[email]}))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          name="FriendlyExpression">LOWER(TRIM(email))</property>
                      </properties>
                    </outputColumn>
                  </outputColumns>
                </output>
              </outputs>
