                      lineageId="Package\DFT Clients\FF Clients.Outputs[Sortie].Columns[id]"
                      name="id" />
                    <outputColumn
                      refId="Package\DFT Clients\FF Clients.Outputs[Sortie].Columns[email]"
                      dataType="wstr"
                      externalMetadataColumnId="Package\DFT Clients\FF Clients.Outputs[Sortie].ExternalColumns[email]"
                      lineageId="Package\DFT Clients\FF Clients.Outputs[Sortie].Columns[email]"
                      name="email" />
                    <outputColumn
