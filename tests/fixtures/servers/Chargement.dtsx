<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationName="Microsoft.Package"
  DTS:ExecutableType="Microsoft.Package"
  DTS:ObjectName="Chargement">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[Entrepot]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{B0000000-0000-0000-0000-000000000001}"
      DTS:ObjectName="Entrepot">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=srv-demo;Initial Catalog=Entrepot;Provider=MSOLEDBSQL;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[DW]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{B0000000-0000-0000-0000-000000000002}"
      DTS:ObjectName="DW">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Provider=MSOLEDBSQL;Server=SRV-DEMO;Database=entrepot;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[Recette]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{B0000000-0000-0000-0000-000000000003}"
      DTS:ObjectName="Recette">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=srv-recette;Initial Catalog=Entrepot;Provider=MSOLEDBSQL;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL Ecrire"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Ecrire">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B0000000-0000-0000-0000-000000000001}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Clients SELECT id FROM stg.Clients" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Lire"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Lire">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B0000000-0000-0000-0000-000000000002}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Rapport SELECT id FROM dbo.Clients" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Recette"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Recette">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B0000000-0000-0000-0000-000000000003}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Clients SELECT id FROM stg.Clients" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
</DTS:Executable>
