                  connectionManagerRefId="Project.ConnectionManagers[Vault]"
                  name="OleDbConnection" />
              </connections>
              <inputs>
                <input
                  refId="Package\DFT Remote\DST Target.Inputs[Input]"
                  name="Input">
                  <inputColumns>
                    <inputColumn
                      refId="Package\DFT Remote\DST Target.Inputs[Input].Columns[id]"
                      cachedName="id"
                      externalMetadataColumnId="Package\DFT Remote\DST Target.Inputs[Input].ExternalColumns[id]"
                      lineageId="Package\DFT Remote\SRC Remote.Outputs[Output].Columns[id]" />
                  </inputColumns>
                </input>
              </inputs>
            </component>
          </components>
          <paths>
            <path
              refId="Package\DFT Remote.Paths[1]"
              endId="Package\DFT Remote\DST Target.Inputs[Input]"
              name="1"
              startId="Package\DFT Remote\SRC Remote.Outputs[Output]" />
          </paths>
