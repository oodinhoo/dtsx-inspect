<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationName="Microsoft.Package"
  DTS:ExecutableType="Microsoft.Package"
  DTS:ObjectName="Appel">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[Entrepot]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{A0000000-0000-0000-0000-000000000001}"
      DTS:ObjectName="Entrepot">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=srv-demo;Initial Catalog=Entrepot;Provider=MSOLEDBSQL;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL Charger"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Charger">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A0000000-0000-0000-0000-000000000001}"
          SQLTask:SqlStatementSource="EXEC dbo.Charger @mode = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Purger"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Purger">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A0000000-0000-0000-0000-000000000001}"
          SQLTask:SqlStatementSource="EXEC [dbo].[Purger]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Inconnue"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Inconnue">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A0000000-0000-0000-0000-000000000001}"
          SQLTask:SqlStatementSource="EXEC dbo.Inconnue" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Lire vue"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Lire vue">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A0000000-0000-0000-0000-000000000001}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Rapport SELECT id FROM dbo.VClients" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Doublon"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Doublon">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A0000000-0000-0000-0000-000000000001}"
          SQLTask:SqlStatementSource="EXEC dbo.Doublon" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
</DTS:Executable>
