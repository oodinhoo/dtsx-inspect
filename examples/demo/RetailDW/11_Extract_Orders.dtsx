              name="SRC Order lines">
              <properties>
                <property
                  dataType="System.String"
                  name="SqlCommand">SELECT o.order_id, o.customer_id, o.order_date, l.product_id, l.quantity, l.unit_price
FROM dbo.Orders AS o
JOIN dbo.OrderLines AS l ON l.order_id = o.order_id
WHERE o.status = 'SHIPPED'</property>
                <property
                  dataType="System.Int32"
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
              </properties>
