<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationName="Microsoft.Package"
  DTS:ExecutableType="Microsoft.Package"
  DTS:ObjectName="20_Load_Warehouse">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimCustomer"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Load DimCustomer">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D0000000-0000-0000-0000-000000000002}"
          SQLTask:SqlStatementSource="INSERT INTO dw.DimCustomer (customer_id, email, country, signup_date)&#xA;SELECT c.customer_id, c.email, UPPER(c.country), c.signup_date&#xA;FROM Staging.stg.Customers AS c&#xA;WHERE c.email IS NOT NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimAccount"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Load DimAccount">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D0000000-0000-0000-0000-000000000002}"
          SQLTask:SqlStatementSource="INSERT INTO dw.DimAccount (account_id, account_name)&#xA;SELECT a.accountid, a.name&#xA;FROM Staging.stg.Accounts AS a" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load FactSales"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="SQL Load FactSales">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D0000000-0000-0000-0000-000000000002}"
          SQLTask:SqlStatementSource="INSERT INTO dw.FactSales&#xA;SELECT * FROM Staging.stg.Orders" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Rebuild indexes"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:Disabled="True"
      DTS:ObjectName="SQL Rebuild indexes">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D0000000-0000-0000-0000-000000000002}"
          SQLTask:SqlStatementSource="ALTER INDEX ALL ON dw.FactSales REBUILD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
</DTS:Executable>
